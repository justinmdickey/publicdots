{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "color-scheme": "prefer-dark",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": false,
  "notification-inline-replies": true,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 520,
  "control-center-height": "100%",
  "notification-window-width": 500,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "example-script": {
      "exec": "echo 'Do something...'",
      "urgency": "Normal"
    },
    "example-action-script": {
      "exec": "echo 'Do something actionable!'",
      "urgency": "Normal",
      "run-on": "action"
    }
  },
  "notification-visibility": {},
  "widgets": [
    "inhibitors",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "title",
    "notifications"
  ],
  "widget-config": {
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": " ",
      "icon-size": 64,
      "icon-radius": 0,
      "show-mute-button": true,
      "show-volume-slider": true,
      "show-volume-percentage": true,
      "show-volume-icon": true
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "command": "hyprctl dispatch exec '[float] ghostty -e nmtui' & swaync-client -t",
          "tooltip": "Network"
        },
        {
          "label": "",
          "command": "better-control & swaync-client -t",
          "tooltip": "Bluetooth"
        },
        {
          "label": "󰂛",
          "command": "swaync-client -d",
          "type": "toggle",
          "tooltip": "DND"
        },
        {
          "label": "",
          "command": "nautilus & swaync-client -t",
          "tooltip": "Files"
        },
        {
          "label": "",
          "command": "better-control & swaync-client -t",
          "tooltip": "Settings"
        },
        {
          "label": "",
          "command": "swaync-client -t & ~/publicdots/scripts/lock.sh",
          "tooltip": "Lock"
        },
        {
          "label": "",
          "command": "~/publicdots/scripts/wallpaper.sh --random",
          "tooltip": "Change Wallpaper"
        },
        {
          /*moon icon*/
          "label": "",
          "command": "~/publicdots/scripts/dark_light_toggle.sh",
          "tooltip": "Dark/Light Mode"
        }
      ]
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 0
    }
  }
}
