{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 3,
  "output": "!HDMI-A-1",
//  "mode": "dock",
//  "margin-right": 10,
//  "margin-left": 10,
//  "margin-bottom": 6,
  "modules-left": [ "group/power", "hyprland/workspaces", "hyprland/window"],
  "modules-center": [ "custom/launcher", "clock"],
  "modules-right": [ "tray", "pulseaudio", "custom/updates", "power-profiles-daemon", "custom/hyprsunset", "network", "battery", "bluetooth", "custom/notification"],

//    "custom/notification": {
//    "format": "{icon}",
//    "format-icons": {
//      "notification": "",
//        "none": "",
//        "dnd-notification": "",
//        "dnd-none": "",
//        "inhibited-notification": "",
//        "inhibited-none": "",
