@import url("/home/justin/.cache/wal/colors-waybar.css");

* {
  font-weight: 600;
}

window#waybar {
  /* background-color: rgba(224,230,237,0.6); */
  /* background: @background; */
  background: transparent;
  font-weight: 600;
  margin: 15px;
}

.module {
  /* background-color: @background; */
  background-color: transparent;
  color: @foreground;
  font-family: "Maple Mono", "Font Awesome 6 Free", "Font Awesome 6 Brands";
  min-width: 30px;
  font-size: 18px;
  border-radius: 50px;
  margin: 3px 2px;
  padding: 0px;
}

.module:hover {
  background-color: @background;
  color: @background;
}

label.module {
  padding: 0px 8px;
  /* min-width: 30px; */
}

#window {
  min-width: 40px;
}
#power-profiles-daemon {
  color: @color8;
}
#power-profiles-daemon:hover {
  background-color: @color8;
  color: @background;
}

#power-profiles-daemon.performance {
  color: @color4;
}
#power-profiles-daemon.performance:hover {
  background-color: @color4;
  color: @background;
}

#power-profiles-daemon.balanced {
  color: @color5;
}
#power-profiles-daemon.balanced:hover {
  background-color: @color5;
  color: @background;
}

#power-profiles-daemon.power-saver {
  color: @color2;
}
#power-profiles-daemon.power-saver:hover {
  background-color: @color2;
  color: @background;
}

.sub-power {
  background-color: @background;
}

.sub-music {
}

#pulseaudio-slider {
  background-color: transparent;
  padding: 0px 10px;
}

#pulseaudio-slider slider {
  background-color: @foreground;
}

#pulseaudio-slider trough {
  min-height: 6px;
  min-width: 150px;
  background-color: @color8;
}

#pulseaudio-slider trough:hover {
  background-color: @color8;
}

#pulseaudio-slider highlight {
  min-width: 10px;
  border-radius: 5px;
  background-color: @color2;
}

#custom-song_progress {
  font-family: "JetBrains Mono";
}

#custom-spotify {
}

#custom-spotify:hover {
  background-color: @color4;
}

#custom-spotify-icon {
  color: @color2;
}

#custom-nowplaying {
}

#custom-nowplaying:hover {
  color: @background;
  background-color: @color2;
}

#pulseaudio {
  color: @color2;
}

#pulseaudio:hover {
  color: @background;
  background-color: @color2;
}

#backlight-slider {
  min-width: 150px;
}

#backlight-slider slider {
  opacity: 0;
  background-image: none;
  border: none;
  box-shadow: none;
}
#backlight-slider trough {
  border-radius: 5px;
}
#backlight-slider highlight {
  min-width: 10px;
  border-radius: 5px;
}

#cpu {
}

#cpu:hover {
  color: @background;
}

#custom-fzf {
  color: @color4;
}

#custom-fzf:hover {
  color: @background;
  background-color: @color4;
}

#custom-launcher {
  color: @color4;
}

#custom-launcher:hover {
  color: @background;
  background-color: @color4;
}

#custom-powermenu {
  border-bottom: 2px solid transparent;
  color: @color3;
}

#custom-powermenu:hover {
  background-color: @color1;
  color: @background;
}

window#waybar.empty #window {
}

#temperature {
}

#temperature.critical {
}

#custom-gputemp {
}

#custom-gputemp.critical {
}

#custom-updates {
  color: @color3;
}

#custom-updates:hover {
  color: @background;
  background-color: @color3;
}

#custom-hyprsunset {
  color: @color1;
}

#custom-hyprsunset:hover {
  color: @background;
  background-color: @color1;
}

#custom-tailscale {
}

#network {
  color: @color5;
}

#network:hover {
  color: @background;
  background-color: @color5;
}

#bluetooth.connected {
  color: @color4;
}

#bluetooth:hover {
  color: @background;
  background-color: @color4;
}

#clock {
  color: @color2;
}

#clock:hover {
  color: @background;
  background-color: @color2;
}

#custom-clock-icon {
  color: @color4;
}

#custom-clock-icon:hover {
  color: @background;
}

#custom-mullvad {
}

#custom-notification {
  margin-right: 6px;
  color: @color8;
}

#custom-notification:hover {
  color: @background;
  background-color: @color1;
}

#custom-tray-icon {
  margin: 0px 0px;
}

#custom-tray-icon:hover {
  background-color: transparent;
  color: white;
}

#tray {
  padding: 0px 12px;
  /* border-bottom: 2px solid @color8; */
}

#tray:hover {
  background-color: transparent;
}

@keyframes blink {
  to {
    color: @color1;
  }
}

#battery {
  color: @color3;
}

#battery.warning:not(.charging) {
  color: @color3;
}

#battery.critical:not(.charging) {
  color: @background;
  animation: blink 1s linear infinite alternate;
}

#battery.charging {
  color: @color2;
}

#battery:hover {
  color: @background;
  background-color: @color3;
}

#custom-hostname {
}

#custom-hostname:hover {
  color: @background;
}

#workspaces {
  border-bottom: 2px solid transparent;
  border-radius: 0px;
}

/* #workspaces:hover { */
/*   background-color: transparent; */
/* } */

#workspaces button {
  border-bottom: 2px solid transparent;
  color: @color2;
  background-color: transparent;
}

#workspaces button:hover {
  background-color: transparent;
  color: @color2;
}

#workspaces button.active {
  border-bottom: 2px solid @color2;
}

#workspaces button:hover {
  background-color: @color2;
  color: @background;
}

#workspaces button.empty {
  color: @color8;
}

#window {
  color: @foreground;
}

#window:hover {
  color: @background;
}
